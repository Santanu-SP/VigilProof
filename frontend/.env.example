# VigilProof Frontend Environment
# Copy to .env and fill in values from your AWS deployment

# API
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_API=false

# AWS Region
VITE_AWS_REGION=ap-south-1

# Cognito — obtain from AWS Console or CloudFormation outputs
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_USER_POOL_CLIENT_ID=

# Cognito Hosted UI (for Google sign-in federation)
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173/login
VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173
